generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Column {
  id        String   @id @default(cuid())
  title     String
  color     String   @default("#6b7280")
  isDone    Boolean  @default(false)
  order     Int
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  order       Int
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId    String
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  String?
  labels      Label[]
  comments    Comment[]
  attachments Attachment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([columnId, order])
  @@index([assigneeId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("member")
  avatarUrl    String?
  bio          String?
  tasks        Task[]
  comments     Comment[]
  attachments  Attachment[]
  playlists    Playlist[]
  createdAt    DateTime @default(now())
}

model Track {
  id          String    @id @default(cuid())
  youtubeId   String
  title       String
  channel     String?
  thumbnail   String?
  genre       String?
  requestedBy String?
  status      String    @default("queued")
  order       Int
  score       Int       @default(0)
  createdAt   DateTime  @default(now())
  playedAt    DateTime?

  @@index([status, order])
}

model BlockedSong {
  id        String   @id @default(cuid())
  term      String
  createdAt DateTime @default(now())

  @@unique([term])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model RequestAttempt {
  id        String   @id @default(cuid())
  scope     String
  ip        String
  createdAt DateTime @default(now())

  @@index([scope, ip, createdAt])
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6b7280")
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([authorId])
}

model Attachment {
  id         String   @id @default(cuid())
  url        String
  filename   String
  size       Int?
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  createdAt  DateTime @default(now())

  @@index([taskId])
  @@index([uploaderId])
}

model Playlist {
  id          String          @id @default(cuid())
  name        String
  isPublic    Boolean         @default(true)
  creator     User?           @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId   String?
  tracks      PlaylistTrack[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([creatorId])
}

model PlaylistTrack {
  id          String   @id @default(cuid())
  youtubeId   String
  title       String
  channel     String?
  thumbnail   String?
  genre       String?
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId  String
  order       Int
  createdAt   DateTime @default(now())

  @@index([playlistId, order])
}
